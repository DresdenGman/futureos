generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ====================
// NextAuth Models
// ====================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  forecasts     Forecast[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ====================
// Business Models
// ====================

model Domain {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  forecasts   Forecast[]
}

model Forecast {
  id                 String           @id @default(cuid())
  title              String
  originalQuestion   String?
  domainId           String
  domain             Domain           @relation(fields: [domainId], references: [id])
  type               ForecastType     @default(BINARY)
  status             ForecastStatus   @default(DRAFT)
  deadline           DateTime
  resolutionCriteria String
  currentProbability Float?
  aiConfidence       ConfidenceLevel?
  creatorId          String?
  creator            User?            @relation(fields: [creatorId], references: [id])
  metadata           Json?
  outcome            ForecastOutcome?
  resolvedAt         DateTime?
  brierScore         Float?
  settlementResult   Boolean?
  settlementNote     String?
  settledAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  evidence           Evidence[]
  probabilityHistory ProbabilityHistory[]
}

model Evidence {
  id          String            @id @default(cuid())
  forecastId  String
  forecast    Forecast          @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  title       String
  summary     String?
  source      String
  sourceUrl   String?
  direction   EvidenceDirection
  credibility CredibilityLevel
  relevance   RelevanceLevel
  createdAt   DateTime          @default(now())
}

model ProbabilityHistory {
  id          String   @id @default(cuid())
  forecastId  String
  forecast    Forecast @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  probability Float
  reason      String
  createdAt   DateTime @default(now())
}

// ====================
// Enums
// ====================

enum ForecastType {
  BINARY
}

enum ForecastOutcome {
  YES
  NO
}

enum ForecastStatus {
  DRAFT
  OPEN
  SETTLED
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

enum EvidenceDirection {
  SUPPORT
  OPPOSE
  NEUTRAL
}

enum CredibilityLevel {
  LOW
  MEDIUM
  HIGH
}

enum RelevanceLevel {
  LOW
  MEDIUM
  HIGH
}
