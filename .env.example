# Database [required]
# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/futureos?schema=public"

# DeepSeek [required for AI features]
# Get API key at: https://platform.deepseek.com
DEEPSEEK_API_KEY=""
# Base URL [optional, defaults to https://api.deepseek.com]
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
# Model [optional, defaults to deepseek-v4-flash]
AI_MODEL="deepseek-v4-flash"

# Tavily Search [required for evidence gathering]
# Get API key at: https://tavily.com
TAVILY_API_KEY=""

# NextAuth v5 (Auth.js) [required]
# Canonical URL of your site [optional for local dev]
AUTH_URL="http://localhost:3000"
# Secret to encrypt cookies. Generate: openssl rand -base64 32
AUTH_SECRET=""

# GitHub OAuth [required for login, optional for MVP core]
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# OpenAI [optional, for future multi-provider support]
# OPENAI_API_KEY=""
